{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "backend-mp",
  "version": "0.1.0-rc.1",
  "identifier": "id.mp.backend",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:4000",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run generate"
  },
  "app": {
    "windows": [
      {
        "title": "backend-mp",
        "width": 3000,
        "height": 1900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
